{
  "rulesetVersion": "1",
  "ruleset": {
    "version": "1",
    "rules": [
      {
        "id": "builtin:phone-id",
        "class": "pattern",
        "pattern": "(?<!\\d)(?:\\+?62|0)8\\d{7,11}\\b",
        "label": "phone-id"
      },
      {
        "id": "builtin:nik",
        "class": "pattern",
        "pattern": "\\b\\d{16}\\b",
        "label": "nik"
      },
      {
        "id": "builtin:bpjs",
        "class": "pattern",
        "pattern": "\\b\\d{13}\\b",
        "label": "bpjs"
      },
      {
        "id": "builtin:mrn",
        "class": "pattern",
        "pattern": "\\bMRN[-\\s]?\\d{4,10}\\b",
        "flags": "i",
        "label": "mrn"
      },
      {
        "id": "builtin:email",
        "class": "pattern",
        "pattern": "\\b[\\w.+-]+@[\\w-]+\\.[A-Za-z]{2,}\\b",
        "label": "email"
      },
      {
        "id": "builtin:dob",
        "class": "pattern",
        "pattern": "\\b(?:\\d{4}-\\d{2}-\\d{2}|\\d{2}/\\d{2}/\\d{4})\\b",
        "label": "dob"
      },
      {
        "id": "fp:patient-name",
        "class": "field-path",
        "pointer": "/patient/name"
      },
      {
        "id": "ds:patient-name",
        "class": "dom-selector",
        "selector": "#patient-name"
      }
    ]
  },
  "fixtures": [
    {
      "id": "json-body-nested-arrayed",
      "kind": "network",
      "payload": {
        "method": "POST",
        "url": "https://api.example.com/patients",
        "status": 200,
        "requestHeaders": {},
        "responseHeaders": {},
        "requestBody": "{\"patient\":{\"name\":\"Siti Rahayu\",\"nik\":\"3175010203040001\",\"dob\":\"1990-05-14\",\"dobAlt\":\"14/05/1990\"},\"visits\":[{\"doctor\":\"Dr. Andi\",\"notes\":\"Patient contact 081234567890\"},{\"doctor\":\"Dr. Budi\",\"notes\":{\"email\":\"siti.rahayu@example.com\"}}]}",
        "responseBody": "{\"status\":\"ok\",\"patient\":{\"bpjs\":\"0219876543210\",\"mrn\":\"MRN-2024007\"}}",
        "bodyTruncated": false,
        "bodyDropped": false,
        "durationMs": 10,
        "sizeBytes": 100
      },
      "forbidden": [
        "Siti Rahayu",
        "3175010203040001",
        "1990-05-14",
        "14/05/1990",
        "081234567890",
        "siti.rahayu@example.com",
        "0219876543210",
        "MRN-2024007"
      ],
      "tsFidelity": "redacted",
