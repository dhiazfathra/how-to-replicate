{
  "name": "how-to-replicate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present build",
    "check:deps": "node ./scripts/check-deps.mjs",
    "e2e": "pnpm build && playwright test",
    "e2e:report": "playwright show-report e2e/artifacts/report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@htr/capture-core": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^5.0.0"
  }
}
